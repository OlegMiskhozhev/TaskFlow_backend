# ==============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (Микросервис Flow)
# ==============================================================================
# ВНИМАНИЕ: Не коммитьте реальные секреты в репозиторий.
# Скопируйте этот файл в '.env.flow' и установите свои значения.

# --- Настройки PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=flow_db_test
POSTGRES_PORT=5432
FLOW_DB_HOST=flow_db_test

# --- Настройки Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0          # [int] Индекс базы данных Redis (обычно от 0 до 15)

# --- Безопасность и шифрование ---
JWT_ALGORITHM=HS256 # [str] Алгоритм подписи JWT-токенов
SECRET_KEY=test_secret_key_for_tests_only_32chars_min # [str] Секретный ключ (минимум 32 символа)
