# --- ПОДКЛЮЧЕНИЕ К СУБД TASKS ---
POSTGRES_USER='tasks_test_user'
POSTGRES_PASSWORD='tasks_test_password'
POSTGRES_DB='tasks_test_db'
POSTGRES_HOST='localhost'
POSTGRES_PORT='5436'

# --- СИНХРОННОЕ ПОДКЛЮЧЕНИЕ К СУБД TASKS ---
TASKS_DB_USER=tasks_test_user'
TASKS_DB_PASSWORD='tasks_test_password'
TASKS_DB='tasks_test_db'
TASKS_DB_HOST='localhost'
TASKS_DB_PORT='5436'

# --- БЕЗОПАСНОСТЬ И JWT ---
SECRET_KEY='tasks_super_secret_test_key_for_jwt_signing_2026'
JWT_ALGORITHM='HS256'
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ПОДКЛЮЧЕНИЕ К REDIS (КЭШ И БРУТФОРС) ---
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_DB='1'

# --- ПОДКЛЮЧЕНИЕ К БРОКЕРУ CELERY ---
CELERY_BROKER_URL='redis://localhost:6379/2'
CELERY_RESULT_BACKEND='redis://localhost:6379/3'

# --- ХРАНИЛИЩЕ MINIO S3 ---
MINIO_ENDPOINT='localhost:9000'
MINIO_ROOT_USER='minio_test_key'
MINIO_ROOT_PASSWORD='minio_test_secret'

# --- ПОЧТОВЫЙ КЛИЕНТ ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=change_me
HOST_URL=http://localhost
HOST_PORT=5173

# --- НАСТРОЙКИ КРИТИЧЕСКИХ ЛОГОВ ---
LOG_LEVEL='INFO'
LOG_FILE_PATH='logs/tasks_errors.log'

# --- OAUTH GOOGLR ---
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=https://localhost:5173

# --- OAUTH GITLAB ---
GITLAB_CLIENT_ID=gitlab_client_id
GITLAB_CLIENT_SECRET=gitlab_client_secret
GITLAB_REDIRECT_URI=https://localhost:5173