# логин и пароль для доступа к базе данных раздела tasks
TASKS_DB_USER=admin
TASKS_DB_PASSWORD=admin123
# имя базы данных раздела tasks (тестовый инстанс)
TASKS_DB=tasks_db_test
# порт и хост БД tasks внутри docker-сети
TASKS_DB_PORT=5432
TASKS_DB_HOST=tasks_db_test
# проброс Postgres tasks на хост; не пересекается с dev (5432) и flow test (5435)
TASKS_DB_PORT_HOST=5436

# логин и пароль для доступа к базе данных раздела flow
FLOW_DB_USER=admin
FLOW_DB_PASSWORD=admin123
# имя базы данных раздела flow (тестовый инстанс)
FLOW_DB=flow_db_test
# порт и хост внутри docker-сети; для flow_tests переопределяется в compose
FLOW_DB_PORT=5432
FLOW_DB_HOST=flow_db_test
# проброс Postgres flow test на хост; dev flow_db использует 5433
FLOW_DB_PORT_HOST=5435

# Хост хранилища MinIO
MINIO_URL=minio:9000
# Логин и пароль для доступа к хранилищу MinIO, произвольные
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# хост и порт почтового сервера для отправки писем
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# логин и пароль для доступа к ящику для отправки писем
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=change_me

# порт и хост брокера
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# url для формирования ссылки для подтверждения регистрации
HOST_URL=http://localhost:5173
HOST_PORT=5173
# endpoint tasks для проверки access JWT из flow
TASKS_USER_ID_URL=http://tasks_backend:8000/user/id

# параметры для шифрования
JWT_ALGORITHM=HS256
SECRET_KEY=test_secret_key_for_tests_only_32chars_min
