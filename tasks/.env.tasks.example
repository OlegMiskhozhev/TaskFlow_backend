# ==============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (Микросервис Tasks)
# ==============================================================================
# ВНИМАНИЕ: Не коммитьте реальные секреты в репозиторий.
# Скопируйте этот файл в '.env.tasks' и установите свои значения.

# --- Настройки PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=tasks_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Настройки Объектного Хранилища MinIO ---
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# --- Настройки SMTP (Почтовый сервер) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587       # [int] Стандартные порты: 587 (TLS) или 465 (SSL)
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=change_me

# --- Настройки Redis (Брокер задач Celery) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0          # [int] Индекс базы данных Redis (0-15)

# --- Настройки Клиента (Фронтенд) ---
HOST_URL=http://localhost  # URL-адрес клиентского приложения
HOST_PORT=5173             # Порт фронтенда (по умолчанию Vite)

# --- Межсервисное Взаимодействие (Внутренние URL) ---
# Endpoint микросервиса Tasks для верификации JWT-токенов из сервиса Flow
# TODO: Будет удален после перехода на общую криптографическую подпись
TASKS_USER_ID_URL=http://tasks_backend:8000/user/id

# --- Безопасность и Шифрование ---
JWT_ALGORITHM=HS256 # [str] Алгоритм подписи JWT-токенов
SECRET_KEY=verysecretkey # [str] Секретный ключ (минимум 32 символа)

# --- Интеграция Google OAuth2 ---
# Настройки берутся из панели https://console.cloud.google.com
GOOGLE_CLIENT_ID=google_Client_ID
GOOGLE_CLIENT_SECRET=google_Client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Интеграция GitLab OAuth2 ---
GITLAB_CLIENT_ID=client
GITLAB_CLIENT_SECRET=secret
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback
